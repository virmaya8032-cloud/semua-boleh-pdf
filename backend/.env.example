# ------- Konfigurasi Pelayan -------
PORT=4000
NODE_ENV=production

# ------- Pangkalan Data (Neon / PostgreSQL) -------
# Dapatkan daripada Neon: https://neon.tech (Connection string, mod "pooled")
DATABASE_URL=postgresql://pengguna:kata_laluan@host.neon.tech/namadb?sslmode=require

# ------- Keselamatan -------
# Jana rahsia rawak yang panjang, cth: openssl rand -base64 48
JWT_SECRET=tukar-kepada-rahsia-rawak-yang-panjang
JWT_EXPIRES=7d

# ------- CORS -------
# Origin frontend anda (pisahkan dengan koma jika lebih daripada satu)
CORS_ORIGINS=http://localhost:5173,https://laman-anda.netlify.app

# ------- Had Fail -------
MAX_FILE_MB=50
FILE_TTL_MIN=30

# ------- Akaun Pentadbir Pertama (dibenih semasa 'npm run migrate') -------
ADMIN_EMAIL=admin@semuabolehpdf.my
ADMIN_PASSWORD=tukar-kata-laluan-admin-ini
ADMIN_NAMA=Pentadbir
